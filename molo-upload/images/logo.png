<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#D12125"/>
      <stop offset="50%" style="stop-color:#F27B21"/>
      <stop offset="100%" style="stop-color:#721517"/>
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <circle cx="100" cy="100" r="95" fill="url(#logoGrad)" filter="url(#glow)" opacity="0.15"/>
  <text x="100" y="115" font-family="Georgia, serif" font-size="80" font-weight="bold" fill="url(#logoGrad)" text-anchor="middle" filter="url(#glow)">MOLO</text>
  <ellipse cx="100" cy="140" rx="40" ry="15" fill="url(#logoGrad)" opacity="0.3"/>
  <ellipse cx="100" cy="140" rx="28" ry="8" fill="url(#logoGrad)" opacity="0.5"/>
</svg>